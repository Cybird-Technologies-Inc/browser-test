# Light profile: scheduled monitoring (suggested: every 15 minutes).
# Safe for a subscriber-facing resolver: one browser, one pass.
# Use with: set -a; . profiles/light.env; set +a; npm start   (or systemd EnvironmentFile=)
# Set RESOLVER_LABEL (for example leohat or baseline) in the caller, not here.
REPEATS=1
CONCURRENCY=1
SETTLE_TIME_MS=3000
# Starting values only: tune them after a few baseline runs.
MAX_FAIL_RATE=0.2
MAX_P95_DNS_MS=300
