# Heavy profile, full load: 10 parallel browsers x 20 repeats.
# On-demand only. Reach it by ramping from heavy-start.env, never as a first run.
# Do NOT run against a live ISP resolver without Amit's agreement (real subscribers);
# stop at the first sign of Recursor stress.
REPEATS=20
CONCURRENCY=10
SETTLE_TIME_MS=3000
MAX_FAIL_RATE=0.2
MAX_P95_DNS_MS=500
