#!/usr/bin/env bash
# Local guard rail: fast checks before every commit. Enable once with `npm run setup`.
# CI runs the same checks, so skipping this hook (--no-verify) only delays the failure.
set -euo pipefail

# Block obvious secrets in staged changes (AWS keys, private keys, password/token assignments).
# Prints only the file name, never the matched value.
pattern='AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----|(password|passwd|secret|token|api[_-]?key)[[:space:]]*[=:][[:space:]]*["'"'"'][^"'"'"']{8,}'
# `|| true`: grep exits 1 on "no match", and xargs -r with no files (only deletions staged) must not look like a hit.
hits=$(git diff --cached --name-only --diff-filter=ACM -z | xargs -0 -r grep -IlEi -- "$pattern" 2>/dev/null || true)
if [ -n "$hits" ]; then
  echo "pre-commit: possible secret in staged file(s):" >&2
  echo "$hits" >&2
  echo "Remove it and read it from an environment variable instead." >&2
  exit 1
fi

# Block result files and archives that .gitignore should already catch (e.g. added with git add -f).
if git diff --cached --name-only --diff-filter=A | grep -E '\.(csv|zip)$'; then
  echo "pre-commit: results/archives must not be committed (see .gitignore)." >&2
  exit 1
fi

npm run --silent check
npm run --silent lint
npm test --silent
