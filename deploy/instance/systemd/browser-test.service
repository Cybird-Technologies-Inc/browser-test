[Unit]
Description=browser-test: run all resolver targets one after another
After=network-online.target
Wants=network-online.target
OnFailure=browser-test-alert.service

[Service]
Type=oneshot
# Root is needed ONLY because run-all.sh writes /etc/systemd/resolved.conf.d and restarts
# systemd-resolved between targets. `npm start` itself runs as the unprivileged user
# browsertest (dropped with setpriv), so the browser never has root.
User=root
# AWS CLI and Node need a writable HOME; /root is hidden by ProtectHome.
Environment=HOME=/var/lib/browser-test
ExecStart=/opt/browser-test/current/deploy/instance/run-all.sh
# Total run time = sum over all targets (each capped by TARGET_TIMEOUT, default 20m).
# Never use infinity: a hung cycle must end and alert.
TimeoutStartSec=90min
# Hardening: write access only where it is needed.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/etc/systemd/resolved.conf.d /var/lib/browser-test /run
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
