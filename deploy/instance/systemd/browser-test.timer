[Unit]
Description=Run browser-test every 15 minutes
# The interval must be longer than one full cycle (the sum of all targets, about 1-3 min each).
# A cycle that is still running makes the next tick skip (flock), which shows as a heartbeat gap.

[Timer]
OnCalendar=*:0/15
RandomizedDelaySec=60
# A missed run is not replayed: the heartbeat alarm should show real gaps.
Persistent=false
Unit=browser-test.service

[Install]
WantedBy=timers.target
